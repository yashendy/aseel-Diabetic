rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // دالة مساعدة للتحقق من أن المستخدم لديه صلاحية أدمن
    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        request.auth.token.role == 'admin'
      );
    }

    // 1. المستخدمين (Users)
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // 2. مكتبة الأغذية وسجل التعديلات (Food Items & History)
    match /admin/global/foodItems/{document=**} {
      allow read: if true;         // متاح للقراءة للأسر ولجميع المستخدمين
      allow write: if isAdmin();   // متاح فقط للأدمن للإضافة والتعديل والأرشفة
    }

    // 3. إعدادات المنظومة وفئات الأطعمة (Settings & Categories)
    match /admin/global/settings/{document=**} {
      allow read: if true;         // متاح للقراءة للأسر ولجميع المستخدمين
      allow write: if isAdmin();   // متاح فقط للأدمن للإضافة والتعديل
    }

    // 4. طلبات إضافة الأصناف من الأسر (Food Requests)
    match /admin/global/foodRequests/{reqId} {
      allow read: if isAdmin();
      allow create: if request.auth != null; // مسموح للأسرة ترسل طلب صنف جديد
      allow update, delete: if isAdmin();    // الأدمن فقط يعتمد أو يرفض الطلب
    }

    // 5. بيانات الأسر والأطفال وسجلات القياسات والوجبات (Parents & Children)
    match /parents/{parentId}/{document=**} {
      allow read, write: if request.auth != null;
    }

    // دعم استعلامات المجموعات الفرعية للأطفال (Collection Group Queries)
    match /{document=**}/children/{childId} {
      allow read, write: if request.auth != null;
    }

    // 6. الأطباء وأكواد الربط (Doctors & Link Codes)
    match /doctors/{doctorId}/{document=**} {
      allow read, write: if request.auth != null;
    }
    match /linkCodes/{codeId} {
      allow read, write: if request.auth != null;
    }
  }
}
